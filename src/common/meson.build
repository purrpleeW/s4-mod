common_sources = run_command(
	'py',
	meson.project_source_root() / 'tools' / 'meson_glob.py',
	meson.current_source_dir(), '.',
).stdout().strip().split('\n')

common_lib = static_library('common',
	sources: common_sources,
	include_directories: [
		include_directories('.'),
		include_directories('../generated'),
	],
	dependencies: [
		asmjit_dep,
		ay_obfuscate_dep,
		backward_cpp_dep,
		codevirtualizer_dep,
		curl_dep,
		discord_rpc_dep,
		imgui_dep,
		libtomcrypt_dep,
		libtommath_dep,
		minhook_dep,
		minizip_dep,
		nlohmann_json_dep,
		rapidjson_dep,
		scylla_dep,
		stb_dep,
		udis86_dep,
		vmprotect_dep,
		whispernet_dep,
		xsk_gsc_s4_dep,
		xsk_gsc_utils_dep,
		xxhash_dep,
		zeroblue_dep,
		zlib_dep,
	],
	cpp_args: ['-DLTM_DESC', '-D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH'],
	override_options: ['cpp_std=c++latest'],
	name_prefix: '',
)

common_dep = declare_dependency(
	link_with: common_lib,
	include_directories: [
		include_directories('.'),
		include_directories('../generated'),
	],
	dependencies: [
		asmjit_dep,
		ay_obfuscate_dep,
		backward_cpp_dep,
		codevirtualizer_dep,
		curl_dep,
		discord_rpc_dep,
		imgui_dep,
		libtomcrypt_dep,
		libtommath_dep,
		minhook_dep,
		minizip_dep,
		nlohmann_json_dep,
		rapidjson_dep,
		scylla_dep,
		stb_dep,
		udis86_dep,
		vmprotect_dep,
		whispernet_dep,
		xsk_gsc_s4_dep,
		xsk_gsc_utils_dep,
		xxhash_dep,
		zeroblue_dep,
		zlib_dep,
	],
)